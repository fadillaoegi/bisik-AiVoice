<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon Android 8+. Launcher memotong dua lapisan ini dengan
  maskernya sendiri (lingkaran, squircle, kotak bulat) tergantung perangkat.
  Latar sengaja warna solid, bukan gambar: mask apa pun tetap terisi penuh.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background"/>
    <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
</adaptive-icon>
