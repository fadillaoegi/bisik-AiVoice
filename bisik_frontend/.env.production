# Build produksi disajikan satu origin dengan gateway Go (lihat Dockerfile:
# STATIC_DIR=/app/public). Karena itu alamat API dan WebSocket HARUS kosong,
# supaya klien memakai origin halaman itu sendiri.
#
# File ini menimpa `.env` saat `vite build`. Tanpa ini, `.env` lokal yang
# berisi localhost:8080 ikut terbundel ke `dist` — dan `dist` disimpan di
# repository lalu disalin ke image Docker, jadi aplikasi yang ter-deploy
# akan memanggil localhost di browser juri.
VITE_API_URL=
VITE_WS_URL=
