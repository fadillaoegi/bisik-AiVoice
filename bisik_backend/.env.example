PORT=8080
DATABASE_URL=postgres://saksi:saksi@localhost:5432/saksi?sslmode=disable

# Wajib diisi — ambil dari dashboard AssemblyAI
ASSEMBLYAI_API_KEY=
ASSEMBLYAI_WS_URL=wss://streaming.assemblyai.com/v3/ws
# Bahasa Indonesia memerlukan Whisper Streaming. Nilai ini sengaja
# configurable karena daftar model streaming AssemblyAI masih berubah.
ASSEMBLYAI_SPEECH_MODEL=whisper-rt
# Model KEDUA, khusus label pembicara. Dijalankan bersamaan atas audio yang
# sama karena tidak ada satu model pun yang memberi transkrip Indonesia bagus
# DAN diarization sekaligus (dibuktikan lewat `go run ./cmd/diarprobe`):
#   whisper-rt   → transkrip bagus, semua pembicara dilabeli "A"
#   multilingual → pembicara terpisah benar, transkrip Indonesia hancur
# Kosongkan untuk kembali ke satu stream; biaya streaming jadi separuh,
# tetapi label pembicara ikut mati.
ASSEMBLYAI_DIARIZER_MODEL=universal-streaming-multilingual
# Minimum resmi 120000 ms; nilai lebih kecil otomatis dinaikkan server.
ASSEMBLYAI_SPEAKER_REVISION_INTERVAL_MS=120000
LLM_MODEL=claude-sonnet-4-6

# Jeda antar bisikan pengingat ke earpiece petugas (detik)
NUDGE_INTERVAL_SECONDS=45

ALLOWED_ORIGINS=http://localhost:5173
# Opsional: hasil build frontend untuk deployment satu-origin.
STATIC_DIR=

# --- Autentikasi ---
# WAJIB. Menandatangani token bearer; tanpa ini backend menolak start.
# Buat nilai acak: make auth-secret
# Mengubahnya membuat semua token yang beredar tidak berlaku.
AUTH_SECRET=
AUTH_TOKEN_TTL_HOURS=12

# Akun awal, HANYA dibuat saat tabel users masih kosong. Dikosongkan berarti
# akun itu tidak dibuat sama sekali — tidak ada kata sandi bawaan.
SEED_OFFICER_USERNAME=petugas
SEED_OFFICER_NAME=Rina Petugas
SEED_OFFICER_PASSWORD=
SEED_SUPERVISOR_USERNAME=supervisor
SEED_SUPERVISOR_NAME=Budi Supervisor
SEED_SUPERVISOR_PASSWORD=
